{
  "name": "ironforge-workbench",
  "private": true,
  "version": "0.1.8",
  "description": "Engineering delivery workbench for GitLab and delivery platforms",
  "author": "Ironforge Workbench Contributors",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "build:desktop": "npm run build && node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "audit:public-release": "npm run build:desktop && node scripts/audit-public-release.mjs",
    "audit:public-artifacts": "node scripts/audit-public-release.mjs",
    "package:source": "node scripts/package-public-source.mjs",
    "desktop": "npm run build:desktop && electron .",
    "stage:git": "node scripts/stage-git-runtime.mjs",
    "package:win": "npm run build:desktop && npm run stage:git && npm run audit:public-artifacts && node scripts/build-windows-installer.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "build": {}
}
