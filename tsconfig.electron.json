{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "server/**/*.ts", "src/domain/**/*.ts"],
  "exclude": ["electron/**/*.test.ts", "server/**/*.test.ts", "src/**/*.test.ts"]
}
